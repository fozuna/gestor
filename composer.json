{
  "name": "traxter/crm",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "vlucas/phpdotenv": "^5.6",
    "dompdf/dompdf": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup-db": "php bin/setup.php",
    "verify-db": "php bin/setup.php --no-env --no-lock",
    "migrate-db": "php bin/migrate.php",
    "backup-db": "php bin/backup.php",
    "check-prod": "php bin/check-production-readiness.php",
    "package-hostinger": "php bin/prepare-hostinger-package.php",
    "test": "phpunit --configuration phpunit.xml"
  },
  "config": {
  "platform": {
    "php": "8.2.30"
  }
}

}
