APP_NAME="TRAXTER CRM"
APP_ENV=local
APP_URL=http://localhost:8000
APP_KEY=change-me-with-random-key
APP_DEBUG=true
APP_TIMEZONE=America/Campo_Grande

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=traxter
DB_USERNAME=root
DB_PASSWORD=change-me

SESSION_NAME=traxter_session
SESSION_SECURE=false
SESSION_SAMESITE=Lax
RECEIPT_PDF_RENDERER=dompdf

# Recomendado em produção:
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE=true
# RECEIPT_PDF_RENDERER=dompdf
# Se o .env não puder ser usado, editar `config/config.php`.

